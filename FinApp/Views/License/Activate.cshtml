@model FinApp.Controllers.LicenseController.LicenseActivateViewModel

@{
    ViewData["Title"] = "Activate License";
}

<a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Back</a>
<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Key" class="control-label"></label>
        <input asp-for="Key" class="form-control">
        <span asp-validation-for="Key" class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-primary">Create License</button>
</form>

